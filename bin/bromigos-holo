#!/usr/bin/env bash
# bromigos-holo — the Stark-lab hologram system: VECTOR (the SpacePort's caretaker, on a
# line to the Wick's console) and the model gallery, on one shared renderer. Starts its
# daemon on first use. The old `pilot` verbs still work (VECTOR was PILOT).
#
#   bromigos-holo vector             show / minimize VECTOR (typed)
#   bromigos-holo ask "question"     ask VECTOR without typing in the window
#   bromigos-holo gallery [model]    open / close the hologram gallery
#   bromigos-holo vector-show | gallery-show   show him / open the gallery, never a toggle (the app launcher's entries)
#   bromigos-holo ptt on|off         push-to-talk (bound to SUPER+V press / release)
#   bromigos-holo mute [on|off|toggle|status]  VECTOR's voice only (bromigos mute: the whole desktop)
#   bromigos-holo voice [auto|<voice>|cycle]   pin a voice (its key in voice.json's voices: main, …), or auto
#   bromigos-holo conversation       hands-free conversation mode on/off (SUPER+SHIFT+E)
#   bromigos-holo chat               VECTOR's chat box pinned shown/hidden (SUPER+ALT+V; folded away by default until you point at him)
#   bromigos-holo history            his past conversations, open/closed
#   bromigos-holo off | on           VECTOR's emergency switch (bromigos vector off|on): off stops his
#                                    commands, his turn and his speech at once; on is yours alone
#   bromigos-holo switch [status|toggle]   on or off; toggle: off at once, on after a YES (SUPER+CTRL+ESCAPE, the bar)
#   bromigos-holo shell off|on|stop  the old names of off and on; stop: stop the running command only
#   bromigos-holo guard log [N]      the guard's audit: protected files that changed, verified or not
#   bromigos-holo work clone|update|status [repo|all]   VECTOR's own clones (his PR workflow); limits|codeowners
#   bromigos-holo status | log
#   bromigos-holo stop [now]         stop the daemon after the current turn (90 s at most), or now
#   bromigos-holo restart [now]      the same, then start it again
#   bromigos-holo evals [--only CAT] [--task ID] [--list]   run VECTOR's eval suite now (headless)
#   bromigos-holo setup [brain|voice|voice-cpu]   make his Python environments (~/.local/share/bromigos/venv-*)
set -u
HERE="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
RUN="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
SOCK="$RUN/bromigos-holo.sock"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/bromigos"
LOG="$STATE/holo.log"
PY=/usr/bin/python3
# the Pydantic AI brain lives in its own venv (system site packages, so GTK still loads)
[ -x "$HOME/.local/share/bromigos/venv-brain/bin/python" ] && PY="$HOME/.local/share/bromigos/venv-brain/bin/python"
export PYDANTIC_AI_NO_BANNER=1
mkdir -p "$STATE"

send() {
    "$PY" - "$SOCK" "$*" <<'EOF'
import socket, sys
s = socket.socket(socket.AF_UNIX)
s.settimeout(6)
try:
    s.connect(sys.argv[1])
except OSError:
    sys.exit(3)
s.sendall(sys.argv[2].encode())
print(s.recv(65536).decode())
EOF
}

start() {
    send status >/dev/null 2>&1 && return 0
    if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
        HYPRLAND_INSTANCE_SIGNATURE="$(ls -t "$RUN/hypr" 2>/dev/null | head -1)"
        export HYPRLAND_INSTANCE_SIGNATURE
    fi
    [ "$(stat -c %s "$LOG" 2>/dev/null || echo 0)" -gt 2000000 ] && mv -f "$LOG" "$LOG.1"
    # exec: the subshell becomes the daemon, so nothing keeps the caller's stdout open
    (cd "$HERE" && exec setsid "$PY" -m holo.app >>"$LOG" 2>&1 < /dev/null &)
    for _ in $(seq 1 50); do
        send status >/dev/null 2>&1 && return 0
        sleep 0.1
    done
    echo "bromigos-holo: daemon did not start (see $LOG)" >&2
    return 1
}

# Stop the daemon: after a running turn (it waits 90 s at most), or at once with "now".
# Returns once it has gone, so a start straight after starts a new one.
stop_daemon() {
    local r
    r="$(send stop ${1:+"$1"} 2>/dev/null)" || return 0    # not running
    [ "$r" = ok ] || echo "$r"                              # "stopping after the current turn"
    for _ in $(seq 1 400); do
        send status >/dev/null 2>&1 || return 0
        sleep 0.25
    done
    echo "bromigos-holo: the daemon is still running (see $LOG)" >&2
    return 1
}

# His Python environments, from the package's requirements (requirements/*.txt). uv when
# it's there (it fetches Python 3.12 for the voice), else python -m venv + pip.
setup() {
    local what="$1" venv req py
    case "$what" in
        brain) venv="$HOME/.local/share/bromigos/venv-brain"; req="$HERE/requirements/brain.txt"; py=/usr/bin/python3 ;;
        voice|voice-cpu) venv="$HOME/.local/share/bromigos/venv-tts"; req="$HERE/requirements/$what.txt"; py=3.12 ;;
        *) echo "bromigos-holo setup brain|voice|voice-cpu" >&2; return 2 ;;
    esac
    [ -f "$req" ] || { echo "bromigos-holo: no $req" >&2; return 1; }
    if command -v uv >/dev/null; then
        if [ "$what" = brain ]; then uv venv --allow-existing --system-site-packages --python "$py" "$venv" || return 1
        else uv venv --allow-existing --python "$py" "$venv" || return 1; fi
        uv pip install --python "$venv/bin/python" -r "$req" || return 1
    else
        [ "$what" = brain ] || { echo "bromigos-holo: the voice needs Python 3.12; install uv (pacman -S uv)" >&2; return 1; }
        /usr/bin/python3 -m venv --system-site-packages "$venv" && "$venv/bin/pip" install -r "$req" || return 1
    fi
    echo "bromigos-holo: $what ready in $venv"
}

# The emergency switch (holo/vector/switch.py): Python's standard library only and never the
# daemon, so a broken venv or a hung VECTOR can't stop it. Off writes its markers here first
# (touch -h never follows a symlink), then switch.py stops his sandbox and tells the daemon.
SWITCH=(/usr/bin/python3 -I "$HERE/holo/vector/switch.py")
SWSTATE="$HOME/.local/state/bromigos"        # where switch.py keeps it (his code's state folder)
switch_off() {
    local d
    for d in "$RUN/bromigos-vector-switch" "$SWSTATE/vector-switch"; do
        mkdir -p "$d" 2>/dev/null && touch -h "$d/off" 2>/dev/null
    done
    "${SWITCH[@]}" off "$@" || {
        # switch.py failed: stop his slice here (cgroup.kill); the markers are already written.
        # Only his own slice: a test's (BROMIGOS_VECTOR_SLICE) is the test's to stop.
        local cg="/sys/fs/cgroup/user.slice/user-$(id -u).slice/user@$(id -u).service/vector.slice/vector-sandbox.slice"
        [ -z "${BROMIGOS_VECTOR_SLICE:-}" ] && [ -w "$cg/cgroup.kill" ] && echo 1 > "$cg/cgroup.kill"
        echo "VECTOR is off (the switch's helper failed; his slice was stopped directly)"
    }
}
switch_is_off() {
    [ -e "$RUN/bromigos-vector-switch/off" ] || [ -L "$RUN/bromigos-vector-switch/off" ] ||
        [ -e "$SWSTATE/vector-switch/off" ] || [ -L "$SWSTATE/vector-switch/off" ] ||
        [ -e "$SWSTATE/vector-shell-off" ] || [ -L "$SWSTATE/vector-shell-off" ] ||
        [ -L "$RUN/bromigos-vector-switch" ] || [ -L "$SWSTATE/vector-switch" ]
}

guard_log() {
    "$PY" - "$STATE/vector-guard.log" "${1:-30}" <<'PYEOF'
import datetime, json, sys
path, n = sys.argv[1], int(sys.argv[2])
try:
    lines = open(path).read().splitlines()[-n:]
except OSError:
    print("the guard has recorded nothing yet (" + path + ")"); sys.exit(0)
if not lines:
    print("the guard has recorded nothing yet (" + path + ")")
how = {"package": "verified: a package update", "extension": "verified: bromigos ext", "no": "UNVERIFIED"}
for line in lines:
    try:
        r = json.loads(line)
    except ValueError:
        continue
    try:                                   # in this machine's time zone
        t = datetime.datetime.strptime(r["t"], "%Y-%m-%dT%H:%M:%S%z").astimezone().strftime("%Y-%m-%d %H:%M %Z")
    except (KeyError, ValueError):
        t = r.get("t", "?")
    paths = r.get("paths") or []
    more = f" (+{r['more']} more)" if r.get("more") else ""
    print(f"{t}  {how.get(r.get('verified'), r.get('verified'))}  {len(paths)} file(s){more}")
    for q in paths[:12]:
        print("    " + q)
    if len(paths) > 12:
        print(f"    … {len(paths) - 12} more")
PYEOF
}

# PILOT -> VECTOR: old verbs from older binds
case "${1:-}" in
    pilot) set -- vector "${@:2}" ;;
    pilot-show) set -- vector-show "${@:2}" ;;
    pilot-hide) set -- vector-hide "${@:2}" ;;
esac

case "${1:-status}" in
    mute)
        # bare: start him and toggle (the pip). on|off|toggle|status (bromigos mute) never start
        # him: running, he's told; not running, his state file is set and he starts with it
        if [ -z "${2:-}" ]; then start && send mute; exit; fi
        case "$2" in on|off|toggle|status) ;; *) echo "bromigos-holo mute [on|off|toggle|status]"; exit 2 ;; esac
        if send status >/dev/null 2>&1; then send mute "$2"; exit; fi
        f="$STATE/vector-voice-muted"
        case "$2" in toggle) [ -e "$f" ] && set -- mute off || set -- mute on ;; esac
        case "$2" in
            on) touch "$f"; echo muted ;;
            off) rm -f "$f"; echo unmuted ;;
            status) [ -e "$f" ] && echo muted || echo unmuted ;;
        esac ;;
    off) shift; switch_off "$@" ;;
    on) shift; exec "${SWITCH[@]}" on "$@" ;;
    switch)
        case "${2:-status}" in
            off) shift 2; switch_off "$@" ;;
            on) shift 2; exec "${SWITCH[@]}" on "$@" ;;
            toggle) shift 2
                    if switch_is_off; then exec "${SWITCH[@]}" toggle "$@"; fi
                    switch_off "$@" ;;
            status|show) exec "${SWITCH[@]}" status ;;
            *) exec "${SWITCH[@]}" help ;;
        esac ;;
    shell)
        case "${2:-}" in
            off) shift 2; switch_off "$@" ;;
            on) shift 2; exec "${SWITCH[@]}" on "$@" ;;
            stop) start && send shell stop ;;
            *) exec "${SWITCH[@]}" status ;;
        esac ;;
    guard)
        case "${2:-log}" in
            log) guard_log "${3:-30}" ;;
            *) echo "bromigos-holo guard log [N]"; exit 2 ;;
        esac ;;
    vector|gallery|ask|ptt|voice|conversation|chat|history|vector-show|vector-hide|gallery-show|gallery-hide|gallery-do|snap)
        start && send "$@" ;;
    status) send status || echo "not running" ;;
    stop|restart)
        case "${2:-}" in "" | now) ;; *) echo "bromigos-holo $1 [now]" >&2; exit 2 ;; esac
        if [ "$1" = stop ]; then
            if send status >/dev/null 2>&1; then stop_daemon "${2:-}" && echo stopped; else echo "not running"; fi
        else
            stop_daemon "${2:-}" && start && echo started
        fi ;;
    log) tail -n 40 "$LOG" ;;
    setup) shift; setup "${1:-brain}" ;;
    evals) shift; cd "$HERE" && exec nice -n 10 "$PY" -m evals.run "$@" ;;
    work) shift; cd "$HERE" && exec "$PY" -m holo.vector.devflow "$@" ;;
    *) awk 'NR > 1 && !/^#/ { exit } NR > 1' "$0"; exit 1 ;;
esac
